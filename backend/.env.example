# ============================================================
# HeatShield AI — Backend Environment Configuration
# Copy this file to .env and fill in real values.
# Nothing here is required for the app to boot: every tier
# below is optional. Tier 5 (deterministic rule engine) works
# with ZERO keys configured, so judges can run this cold.
# ============================================================

# --- FortyGuard Temperature API -------------------------------
# tOS Enterprise API key (Hackathon plan). The API is task-based: we POST
# /v1/env_params, poll /v1/status/{id}, and anchor the deterministic engine
# on the REAL observed apparent temperature. Blank → simulated field.
FORTYGUARD_API_KEY=

# --- Tier 1 & 2: Groq (ultra-low latency reasoning) -----------
GROQ_API_KEY_1=
GROQ_API_KEY_2=

# --- Tier 3: Google Gemini (tertiary safety net) ---------------
GEMINI_API_KEY=

# --- App config --------------------------------------------------
# Comma-separated list of extra allowed CORS origins beyond the
# defaults (localhost:3000, *.vercel.app)
EXTRA_CORS_ORIGINS=

# SQLite checkpoint DB path (LangGraph thread persistence)
CHECKPOINT_DB_PATH=./heatshield_checkpoints.sqlite

# Default demo location if the client omits one (FortyGuard covers US only)
DEFAULT_CITY=Phoenix, AZ
DEFAULT_LAT=33.4484
DEFAULT_LON=-112.0740

# --- Observation cache (Pillar 4) -------------------------------
# SQLite file for the thermal-field cache. Use ":memory:" in tests.
OBSERVATION_CACHE_PATH=./heatshield_cache.sqlite

# --- Rate limiting (Pillar 2) ------------------------------------
RATE_LIMIT_MAX=60
RATE_LIMIT_WINDOW_S=60

# --- FortyGuard polling budget (Pillar 2) ------------------------
# Legacy heatmap poll-deadline (kept for the grid path).
FORTYGUARD_POLL_MAX_ATTEMPTS=20
FORTYGUARD_POLL_INTERVAL_S=0.75
FORTYGUARD_ATTEMPT_TIMEOUT_S=3.0
FORTYGUARD_DEADLINE_S=15.0

# Live env_params (scoring path) budget — async task can take ~30–120s.
FORTYGUARD_ENV_DEADLINE_S=120.0
FORTYGUARD_SUBMIT_TIMEOUT_S=20.0

# --- Autonomous dispatch (Pillar 4) -------------------------------
# Supervisor contacts (comma-separated E.164 numbers or emails) that
# receive SMS/voice alerts when Response Gap R >= 7.0. Without Twilio
# creds the dispatcher runs in DRY RUN mode and logs previews only.
HEATSHIELD_SUPERVISOR_CONTACTS=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
